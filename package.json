{
  "name": "speldwerk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts",
    "data": "node --max-old-space-size=6000 scripts/build-all.mjs",
    "data:stations": "node scripts/build-stations.mjs",
    "data:stadiums": "node scripts/build-stadiums.mjs",
    "data:natura2000": "node scripts/build-natura2000.mjs",
    "data:towns": "node --max-old-space-size=6000 scripts/build-towns.mjs",
    "data:water": "node scripts/build-water.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20",
    "mapshaper": "0.6.113",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
